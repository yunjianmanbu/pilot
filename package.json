{
  "name": "pilot-agent",
  "version": "0.1.81",
  "private": true,
  "license": "Apache-2.0",
  "description": "Pilot — a local-first self-improving coding agent",
  "author": "Pilot",
  "main": "out/main/index.js",
  "bin": {
    "pilot": "bin/pilot.js"
  },
  "files": [
    "bin/",
    "out/server/",
    "companion/",
    "builtin-tools/"
  ],
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "build:server": "vite build --config vite.server.config.mjs",
    "prepack": "npm run build:server",
    "build:all": "pnpm typecheck && electron-vite build && vite build --config vite.server.config.mjs",
    "serve": "node bin/pilot.js serve",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "theme:check": "node ./scripts/gen-appearance-css.mjs --check",
    "test": "node ./scripts/gen-appearance-css.mjs --check && vitest run tests",
    "prepare:self-source": "node scripts/prepare-self-source.mjs",
    "package:dir": "pnpm prepare:self-source && pnpm build && electron-builder --dir",
    "self-build": "node scripts/self-build.mjs",
    "package:win": "pnpm prepare:self-source && pnpm build && electron-builder --win",
    "package:mac": "pnpm prepare:self-source && pnpm build && electron-builder --mac -c.electronVersion=43.8.7",
    "package:linux": "pnpm prepare:self-source && pnpm build && electron-builder --linux",
    "package:source": "node ./scripts/pack-source.mjs",
    "builtin:pack": "node ./scripts/pack-builtin-tools.mjs --from ../../.pilot/tools",
    "contribution:review": "node ./scripts/contribution-review.mjs",
    "module-check": "jiti scripts/module-check-cli.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
